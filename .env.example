# ============================================================
# SYJ AI ARENA — PROVIDER CONFIGURATION
# ============================================================

# Provider used by the arena.
# Supported:
#   openai
#   anthropic
PROVIDER=openai

# ============================================================
# OPENAI
# ============================================================

OPENAI_API_KEY=

# Recommended default can be changed without touching source.
OPENAI_MODEL=gpt-5.5

# ============================================================
# ANTHROPIC
# ============================================================

ANTHROPIC_API_KEY=

# Current Anthropic model can be changed here.
ANTHROPIC_MODEL=claude-opus-4-6

# ============================================================
# ARENA
# ============================================================

# Number of dynamic cross-fire exchanges.
CROSSFIRE_EXCHANGES=3

# Maximum retries for transient provider errors.
MAX_RETRIES=3

# Optional delay between API calls in milliseconds.
# Useful for rate-limit management.
REQUEST_DELAY_MS=250
